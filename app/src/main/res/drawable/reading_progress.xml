<?xml version="1.0" encoding="utf-8"?>
<!-- How far a book is read, in the free space above its cover: a rounded brass rod filling a dark
     groove with a brass rim. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape>
            <corners android:radius="5dp" />
            <gradient
                android:angle="270"
                android:endColor="#FF2E1C10"
                android:startColor="#FF0E0804" />
            <stroke
                android:width="1dp"
                android:color="@color/gold_dark" />
        </shape>
    </item>
    <!-- Scaled rather than clipped, so that the rod keeps its round end. -->
    <item
        android:id="@android:id/progress"
        android:bottom="2dp"
        android:left="2dp"
        android:right="2dp"
        android:top="2dp">
        <scale
            android:scaleGravity="left"
            android:scaleWidth="100%">
            <shape>
                <corners android:radius="3dp" />
                <gradient
                    android:angle="270"
                    android:centerColor="#FFE9C44C"
                    android:endColor="#FFA87C1C"
                    android:startColor="#FFFFF6C0" />
            </shape>
        </scale>
    </item>
</layer-list>
