<?xml version="1.0" encoding="utf-8"?>
<!-- The dark plate a word for the reader stands on over the widget's books (widget_favorites.xml):
     the wood of the back of the case, grain and all. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <solid android:color="#E62A1A10" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <item android:width="1dp" android:height="1dp" android:gravity="fill" android:bottom="1dp" android:left="1dp" android:right="1dp" android:top="1dp">
        <bitmap android:src="@drawable/wood_grain" android:tileMode="repeat" />
    </item>
    <item>
        <shape>
            <corners android:radius="6dp" />
            <stroke android:width="1dp" android:color="@color/gold_dark" />
        </shape>
    </item>
</layer-list>
