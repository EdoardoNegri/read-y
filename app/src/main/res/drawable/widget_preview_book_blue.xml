<?xml version="1.0" encoding="utf-8"?>
<!-- A leather-bound book on the widget's preview (widget_preview.xml), like the covers Library draws for books without one. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <size android:width="40dp" android:height="60dp" />
            <solid android:color="#FF1F3A5F" />
        </shape>
    </item>
    <item android:bottom="3dp" android:left="3dp" android:right="3dp" android:top="3dp">
        <shape>
            <stroke android:width="1dp" android:color="@color/gold" />
        </shape>
    </item>
</layer-list>
