<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <gradient
                android:angle="0"
                android:centerColor="@color/shelf_back_light"
                android:endColor="@color/shelf_back"
                android:startColor="@color/shelf_back" />
        </shape>
    </item>
    <!-- The grain of the boards it is made of, which stand upright. -->
    <item android:width="1dp" android:height="1dp" android:gravity="fill">
        <bitmap android:src="@drawable/wood_grain_upright" android:tileMode="repeat" />
    </item>
</layer-list>
