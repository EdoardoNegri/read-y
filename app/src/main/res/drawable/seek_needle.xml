<?xml version="1.0" encoding="utf-8"?>
<!-- The knob of the reader's seek bar: the place being read, as a yellow line across it, as the
     chapters are marked across it (ChapterMarks). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <size
        android:width="3dp"
        android:height="16dp" />
    <corners android:radius="1.5dp" />
    <solid android:color="#FFFFD60A" />
</shape>
