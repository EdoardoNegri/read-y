<?xml version="1.0" encoding="utf-8"?>
<!-- The front face of a shelf plank, as drawn by ShelfDecoration.drawPlank: lit top edge, dark underside. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <gradient
                android:angle="270"
                android:endColor="#FF5C3A1E"
                android:startColor="#FF8B5A2B" />
        </shape>
    </item>
    <!-- The grain of the wood, which runs along the board. It fills the board whatever size the
         picture of it has, which the board would otherwise take for its own. -->
    <item android:width="1dp" android:height="1dp" android:gravity="fill">
        <bitmap android:src="@drawable/wood_grain" android:tileMode="repeat" />
    </item>
    <item android:height="1dp" android:gravity="top">
        <shape>
            <solid android:color="#40FFE2B0" />
        </shape>
    </item>
    <item android:height="1.5dp" android:gravity="bottom">
        <shape>
            <solid android:color="#66000000" />
        </shape>
    </item>
</layer-list>
