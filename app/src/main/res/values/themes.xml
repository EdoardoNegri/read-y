<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- The bookshelf is always dark wood, whatever the system theme. -->
    <style name="Theme.Ready" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">@color/gold</item>
        <item name="colorAccent">@color/gold</item>
        <item name="android:windowBackground">@color/wood_dark</item>
    </style>

    <!-- A brass plate used as a button; its background is a PlaqueDrawable set in code. -->
    <style name="BrassButton">
        <item name="android:layout_height">40dp</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingBottom">2dp</item>
        <item name="android:fontFamily">serif</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/plaque_text</item>
        <item name="android:singleLine">true</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
    </style>

    <!-- The plate that names the bookcase on its top rail, and every dialog; its background is an
         ornate PlaqueDrawable set in code. It is as wide as the place it is given, whatever it
         says. A name too long for one line is written smaller, in two. -->
    <style name="TitlePlate">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">45dp</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:layout_marginStart">4dp</item>
        <item name="android:layout_marginEnd">4dp</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">26dp</item>
        <item name="android:paddingEnd">26dp</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">2dp</item>
        <item name="android:fontFamily">serif</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize" tools:ignore="SpUsage">18dp</item>
        <item name="android:textColor">@color/plaque_text</item>
        <item name="android:maxLines">2</item>
        <item name="autoSizeTextType">uniform</item>
        <item name="autoSizeMinTextSize">12dp</item>
        <item name="autoSizeMaxTextSize">18dp</item>
        <item name="autoSizeStepGranularity">1dp</item>
        <item name="android:lineSpacingMultiplier">0.85</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:ellipsize">end</item>
        <item name="android:shadowColor">#99FFF6C8</item>
        <item name="android:shadowDy">1</item>
        <item name="android:shadowRadius">1</item>
    </style>

    <style name="Theme.Ready.Settings">
        <!-- The back wall of the case, grain and all. -->
        <item name="android:windowBackground">@drawable/shelf_back</item>
    </style>

    <!-- Nothing but what is drawn in it: the home screen shows through (WidgetOpenActivity). -->
    <style name="Theme.Ready.Clear">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- No picture stands in for the reader while it starts: what it takes over from, the page a
         book was opened to, stays in view until then. -->
    <style name="Theme.Ready.Reader">
        <item name="android:windowDisablePreview">true</item>
        <item name="android:windowBackground">@color/black</item>
    </style>

    <!-- The reader while its book opens on the shelf under it (OpeningReaderActivity), which it
         lets show through; it is made solid once the book is open. -->
    <style name="Theme.Ready.Reader.Opening">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>
</resources>
