<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <include layout="@layout/top_bar" />

    <!-- Shown while searching; what is typed is looked for on this shelf and all those inside it,
         or among the favorites of the whole library while the star is on. -->
    <LinearLayout
        android:id="@+id/searchRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/shelf_plank"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="8dp"
        android:paddingEnd="0dp"
        android:paddingStart="0dp"
        android:paddingTop="4dp"
        android:visibility="gone">

        <ImageButton
            android:id="@+id/starred"
            android:layout_width="48dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/favorites"
            android:src="@drawable/ic_star_outline" />

        <EditText
            android:id="@+id/query"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="@drawable/field"
            android:fontFamily="serif"
            android:hint="@string/search_hint"
            android:imeOptions="actionSearch|flagNoExtractUi"
            android:importantForAutofill="no"
            android:inputType="text"
            android:paddingEnd="12dp"
            android:paddingStart="12dp"
            android:textColor="@color/cream"
            android:textColorHint="@color/gold_dark"
            android:textSize="16sp" />

        <ImageButton
            android:id="@+id/closeSearch"
            android:layout_width="48dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/close"
            android:src="@drawable/ic_close" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/shelf"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/shelf_back"
            android:clipToPadding="false" />

        <!-- Snapshot of the shelf being left, shown only during the folder-opening animation. -->
        <ImageView
            android:id="@+id/ghost"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="fitXY"
            android:visibility="gone" />

        <!-- Hangs under the name plate while books are chosen: the star that makes
             favorites of them, the tick that marks them as read, the bin that deletes them, and
             a cross that lets go of them all. Books can be dropped on the three as well. It lies
             over the shelf, which stays where it is. -->
        <LinearLayout
            android:id="@+id/pickRow"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="4dp"
            android:background="@drawable/panel_wood"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingEnd="2dp"
            android:paddingStart="6dp"
            android:translationZ="3dp"
            android:visibility="gone">

            <ImageButton
                android:id="@+id/pickStar"
                android:layout_width="42dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/favorite"
                android:src="@drawable/ic_star_outline" />

            <ImageButton
                android:id="@+id/pickRead"
                android:layout_width="42dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/finished"
                android:src="@drawable/ic_check_outline" />

            <ImageButton
                android:id="@+id/bin"
                android:layout_width="42dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/delete"
                android:src="@drawable/ic_delete" />

            <!-- Set apart from the three by a brass line. -->
            <View
                android:layout_width="1dp"
                android:layout_height="20dp"
                android:layout_marginStart="4dp"
                android:background="@color/gold_dark" />

            <ImageButton
                android:id="@+id/closePick"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/close"
                android:scaleX="0.8"
                android:scaleY="0.8"
                android:src="@drawable/ic_close" />
        </LinearLayout>

        <!-- Shown for a few seconds after books or shelves are deleted: they can be taken back until it goes. -->
        <LinearLayout
            android:id="@+id/undoBar"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_margin="16dp"
            android:background="@drawable/panel_wood"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="18dp"
            android:translationZ="3dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/undoText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="serif"
                android:maxWidth="230dp"
                android:singleLine="true"
                android:textColor="@color/cream"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/undo"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:foreground="?attr/selectableItemBackground"
                android:fontFamily="serif"
                android:gravity="center"
                android:minWidth="64dp"
                android:paddingEnd="18dp"
                android:paddingStart="18dp"
                android:text="@string/undo"
                android:textColor="@color/gold_light"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_margin="24dp"
            android:background="@drawable/panel_wood"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="22dp"
            android:translationZ="3dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/emptyText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="serif"
                android:gravity="center"
                android:lineSpacingExtra="3dp"
                android:textColor="@color/cream"
                android:textSize="15sp" />

            <!-- The background is a PlaqueDrawable set in code. -->
            <TextView
                android:id="@+id/grant"
                style="@style/BrassButton"
                android:layout_width="wrap_content"
                android:layout_marginTop="18dp"
                android:paddingEnd="24dp"
                android:paddingStart="24dp"
                android:text="@string/grant_access" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
