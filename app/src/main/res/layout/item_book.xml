<?xml version="1.0" encoding="utf-8"?>
<!-- A place on a shelf; its paddings at the sides are ShelfSpec.gap. The bottom 44dp (plaque plus margins) sits on the plank drawn by ShelfDecoration. The plaque's
     background is a PlaqueDrawable set in code; its paddings keep the title clear of the screws.
     Tapping the plaque shows the details; tapping anywhere else opens the book or the shelf. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    tools:ignore="Overdraw"
    android:orientation="vertical"
    android:clipToPadding="false"
    android:paddingEnd="7dp"
    android:paddingStart="7dp">

    <!-- The free space under the shelf above. It holds the bar that shows how far a book is read,
         right under that shelf and clear of the cover, and as long as the book is
         wide; ShelfAdapter makes it lower for a case, which stands taller. -->
    <FrameLayout
        android:id="@+id/gap"
        android:layout_width="match_parent"
        android:layout_height="14dp">

        <ProgressBar
            android:id="@+id/progress"
            android:importantForAccessibility="no"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="7dp"
            android:layout_gravity="top"
            android:max="100"
            android:progressDrawable="@drawable/reading_progress"
            android:visibility="gone" />
    </FrameLayout>

    <!-- ShelfAdapter lets it reach into the paddings at the sides for a case, which is wider than a book. -->
    <FrameLayout
        android:id="@+id/coverFrame"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <io.github.edoardonegri.ready.RatioImageView
            android:id="@+id/cover"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FF24160D"
            android:scaleType="centerCrop"
            android:importantForAccessibility="no" />

        <!-- The shelf the book stands on, shown on the books a search found. -->
        <TextView
            android:id="@+id/place"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="#E61A0F08"
            android:ellipsize="middle"
            android:fontFamily="serif"
            android:gravity="center"
            android:paddingBottom="3dp"
            android:paddingEnd="4dp"
            android:paddingStart="4dp"
            android:paddingTop="3dp"
            android:singleLine="true"
            android:textColor="@color/gold_light"
            android:textSize="11sp"
            android:textStyle="italic"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/plaque"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:layout_marginBottom="6dp"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:fontFamily="serif"
        android:gravity="center"
        android:lineSpacingMultiplier="0.9"
        android:maxLines="2"
        android:paddingBottom="2dp"
        android:paddingEnd="13dp"
        android:paddingStart="13dp"
        android:shadowColor="#99FFF6C8"
        android:shadowDy="1"
        android:shadowRadius="1"
        android:textColor="@color/plaque_text"
        android:textSize="11dp"
        tools:ignore="SpUsage"
        android:textStyle="bold" />
</LinearLayout>
