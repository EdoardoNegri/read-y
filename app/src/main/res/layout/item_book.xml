<?xml version="1.0" encoding="utf-8"?>
<!-- The bottom 44dp (plaque plus margins) sits on the plank drawn by ShelfDecoration. The plaque's
     background is a PlaqueDrawable set in code; its paddings keep the title clear of the screws.
     Tapping the plaque shows the details; tapping anywhere else opens the book or the shelf. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:orientation="vertical"
    android:paddingEnd="9dp"
    android:paddingStart="9dp">

    <!-- The free space under the shelf above. It holds the bar that shows how far a book is read,
         clear of the cover; ShelfAdapter makes it lower for a case, which stands taller. -->
    <FrameLayout
        android:id="@+id/gap"
        android:layout_width="match_parent"
        android:layout_height="16dp">

        <ProgressBar
            android:id="@+id/progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="9dp"
            android:layout_gravity="bottom"
            android:layout_marginBottom="3dp"
            android:max="100"
            android:progressDrawable="@drawable/reading_progress"
            android:visibility="gone" />
    </FrameLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.example.read_y.RatioImageView
            android:id="@+id/cover"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FF24160D"
            android:scaleType="centerCrop"
            android:importantForAccessibility="no" />

        <!-- The shelf the book stands on, shown on the books a search found. -->
        <TextView
            android:id="@+id/place"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="#E61A0F08"
            android:ellipsize="middle"
            android:fontFamily="serif"
            android:gravity="center"
            android:paddingBottom="3dp"
            android:paddingEnd="4dp"
            android:paddingStart="4dp"
            android:paddingTop="3dp"
            android:singleLine="true"
            android:textColor="@color/gold_light"
            android:textSize="11sp"
            android:textStyle="italic"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/plaque"
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:layout_marginBottom="5dp"
        android:layout_marginTop="5dp"
        android:ellipsize="end"
        android:fontFamily="serif"
        android:gravity="center"
        android:lineSpacingMultiplier="0.9"
        android:maxLines="2"
        android:paddingBottom="2dp"
        android:paddingEnd="13dp"
        android:paddingStart="13dp"
        android:shadowColor="#99FFF6C8"
        android:shadowDy="1"
        android:shadowRadius="1"
        android:textColor="@color/plaque_text"
        android:textSize="11dp"
        android:textStyle="bold" />
</LinearLayout>
