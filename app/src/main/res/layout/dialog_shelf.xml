<?xml version="1.0" encoding="utf-8"?>
<!-- See ShelfDialog: a wooden panel with a brass title plate over whichever of these it is given:
     a few words, details in two columns, a picture with fields beside it, a text field, a column of
     choices, one wide brass button. The plates'
     backgrounds are PlaqueDrawables set in code. The window behind the panel is made
     transparent in code, so nothing is overdrawn. The panel takes the first focus, so that a title
     that can be edited does not bring the keyboard up by itself. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/panel_wood"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:orientation="vertical"
    android:padding="18dp"
    tools:ignore="Overdraw">

    <!-- The plate in the middle, between the buttons at its sides: at the left the arrow that
         leads back, at the right the cross. Both sides
         are at least a button wide, so that the plate stays in the middle, and the paddings of
         the buttons put their pictures as far from the edge of the panel as from the plate. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:minWidth="44dp"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/dialogBack"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:paddingStart="0dp"
                android:paddingEnd="14dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/back"
                android:src="@drawable/ic_back"
                android:visibility="gone" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <TextView
                android:id="@+id/dialogTitle"
                style="@style/TitlePlate" />

        </FrameLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:gravity="end"
            android:minWidth="44dp"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/dialogClose"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:paddingStart="14dp"
                android:paddingEnd="0dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/close"
                android:src="@drawable/ic_close" />
        </LinearLayout>
    </LinearLayout>

    <!-- A few words, such as what is about to be deleted. -->
    <TextView
        android:id="@+id/dialogDetails"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:fontFamily="serif"
        android:lineSpacingExtra="4dp"
        android:textColor="@color/cream"
        android:textSize="14sp"
        android:visibility="gone" />

    <!-- The details of a book or a shelf, two to a line; ShelfDialog adds the lines. -->
    <LinearLayout
        android:id="@+id/dialogGrid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="vertical"
        android:visibility="gone" />

    <!-- The picture of a book or a shelf, with the fields that change it at its right: its
         name, and the like. ShelfDialog adds the fields. -->
    <LinearLayout
        android:id="@+id/dialogForm"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:visibility="gone">

        <io.github.edoardonegri.ready.RatioImageView
            android:id="@+id/dialogPicture"
            android:layout_width="96dp"
            android:layout_height="wrap_content"
            android:contentDescription="@string/cover" />

        <LinearLayout
            android:id="@+id/dialogFields"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:orientation="vertical" />
    </LinearLayout>

    <EditText
        android:id="@+id/dialogInput"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/field"
        android:fontFamily="serif"
        android:imeOptions="actionDone|flagNoExtractUi"
        android:hint="@string/shelf_name"
        android:importantForAutofill="no"
        android:inputType="textCapSentences"
        android:paddingEnd="12dp"
        android:paddingStart="12dp"
        android:textColor="@color/cream"
        android:textColorHint="@color/gold_dark"
        android:textSize="16sp"
        android:visibility="gone" />

    <!-- One button or line per choice, added in code; a long column scrolls. -->
    <ScrollView
        android:id="@+id/dialogScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/dialogOptions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <!-- A choice between two things that goes with the choices above without being one of them:
         two buttons side by side, set apart by a brass line. One of them is held down. -->
    <View
        android:id="@+id/dialogRule"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="16dp"
        android:background="@color/gold_dark"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/dialogPair"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/dialogFirst"
            style="@style/BrassButton"
            android:layout_width="0dp"
            android:layout_marginEnd="5dp"
            android:layout_marginTop="10dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/dialogSecond"
            style="@style/BrassButton"
            android:layout_width="0dp"
            android:layout_marginStart="5dp"
            android:layout_marginTop="10dp"
            android:layout_weight="1" />
    </LinearLayout>

    <TextView
        android:id="@+id/dialogPrimary"
        style="@style/BrassButton"
        android:layout_width="match_parent"
        android:layout_marginTop="18dp"
        android:visibility="gone" />
</LinearLayout>
