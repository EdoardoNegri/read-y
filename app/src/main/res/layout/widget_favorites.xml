<?xml version="1.0" encoding="utf-8"?>
<!-- A bookcase: the shelves scroll between two side posts that stay put. Each list item is one
     whole shelf (widget_row.xml), put together by FavoritesWidget. The case fills the widget: it
     takes its size from an empty picture of the widget's shape, which is made as large as the
     widget has room for whatever the home screen says its size is.
     A home screen that cuts the corners of its widgets round, as Samsung's does whatever the
     widget says, rounds the whole widget, so the id below is on the layout it rounds, and the
     case, which fills it, has its corners rounded with it. -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center">

<ImageView
    android:id="@+id/shape"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:adjustViewBounds="true"
    android:importantForAccessibility="no" />

<FrameLayout
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_alignBottom="@id/shape"
    android:layout_alignLeft="@id/shape"
    android:layout_alignRight="@id/shape"
    android:layout_alignTop="@id/shape"
    android:background="@drawable/widget_bg"
    tools:ignore="RtlHardcoded">

    <ListView
        android:id="@+id/shelves"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:divider="@null"
        android:dividerHeight="0dp"
        android:listSelector="@android:color/transparent"
        android:paddingEnd="11dp"
        android:paddingStart="11dp"
        android:scrollbars="none" />

    <TextView
        android:id="@+id/empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fontFamily="serif"
        android:gravity="center"
        android:paddingEnd="20dp"
        android:paddingStart="20dp"
        android:text="@string/widget_empty"
        android:textColor="@color/gold_light"
        android:textSize="13sp" />

    <ImageView
        android:layout_width="18dp"
        android:layout_height="match_parent"
        android:layout_gravity="left"
        android:background="@drawable/widget_post_left"
        android:importantForAccessibility="no"
        tools:ignore="RtlHardcoded" />

    <ImageView
        android:layout_width="18dp"
        android:layout_height="match_parent"
        android:layout_gravity="right"
        android:background="@drawable/widget_post_right"
        android:importantForAccessibility="no"
        tools:ignore="RtlHardcoded" />
</FrameLayout>
</RelativeLayout>
