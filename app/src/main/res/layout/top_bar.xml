<?xml version="1.0" encoding="utf-8"?>
<!-- The top rail of the bookcase with its name plate in the middle; its top padding is the status
     bar inset. Both sides are equally wide and what is not needed is hidden with "invisible", so
     the plate stays centred. The paddings of the buttons put the drawn shapes where the border, the
     arrow, the open book and the plate are equally far from each other (about 19dp). On the other
     side the dots stand about 27dp from the border, and the lens about 23dp from the dots and
     from the plate: the two are narrower than the arrow and the book together. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/bar"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/shelf_plank"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <io.github.edoardonegri.ready.RailButton
        android:id="@+id/up"
        android:layout_width="46dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/back"
        android:paddingStart="9dp"
        android:paddingEnd="0dp"
        android:src="@drawable/ic_back"
        android:visibility="invisible" />

    <!-- Shown on the bookshelf, where it goes on with the book that was read last. It stands
         where the lens does on the other side. -->
    <io.github.edoardonegri.ready.RailButton
        android:id="@+id/resume"
        android:layout_width="46dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/resume"
        android:paddingStart="0dp"
        android:paddingEnd="7dp"
        android:src="@drawable/ic_resume"
        android:visibility="invisible" />

    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="54dp"
        android:layout_weight="1">

        <!-- The background is a PlaqueDrawable set in code. Larger than the plates of the dialogs. -->
        <TextView
            android:id="@+id/barTitle"
            style="@style/TitlePlate"
            android:layout_height="50dp"
            android:textSize="21dp"
            app:autoSizeMaxTextSize="21dp"
            tools:ignore="SpUsage" />
    </FrameLayout>

    <io.github.edoardonegri.ready.RailButton
        android:id="@+id/search"
        android:layout_width="46dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:paddingStart="12dp"
        android:paddingEnd="0dp"
        android:contentDescription="@string/search"
        android:src="@drawable/ic_search" />

    <io.github.edoardonegri.ready.RailButton
        android:id="@+id/more"
        android:layout_width="46dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:paddingStart="0dp"
        android:paddingEnd="13dp"
        android:contentDescription="@string/more"
        android:src="@drawable/ic_more" />
</LinearLayout>
