<?xml version="1.0" encoding="utf-8"?>
<!-- The top rail of the bookcase with its name plate in the middle; its top padding is the status
     bar inset. Both sides are equally wide and what is not needed is hidden with "invisible", so
     the plate stays centred. Its height is repeated in ShelfSpec.rail, for the bare rail drawn on
     the folder miniatures. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/bar"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/shelf_plank"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <ImageButton
        android:id="@+id/up"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/back"
        android:src="@drawable/ic_back"
        android:visibility="invisible" />

    <Space
        android:layout_width="40dp"
        android:layout_height="48dp" />

    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="49dp"
        android:layout_weight="1">

        <!-- The background is a PlaqueDrawable set in code. -->
        <TextView
            android:id="@+id/barTitle"
            style="@style/TitlePlate" />
    </FrameLayout>

    <ImageButton
        android:id="@+id/search"
        android:layout_width="40dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/search"
        android:src="@drawable/ic_search" />

    <ImageButton
        android:id="@+id/more"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/more"
        android:src="@drawable/ic_more" />
</LinearLayout>
