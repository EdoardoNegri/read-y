<?xml version="1.0" encoding="utf-8"?>
<!-- What is backed up with the app (Android 12 and later) or moved to a new phone. -->
<data-extraction-rules>
    <!-- The covers and the details read from the books are drawn and read again from the books themselves. -->
    <cloud-backup>
        <exclude domain="file" path="covers"/>
        <exclude domain="sharedpref" path="meta.xml"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="covers"/>
        <exclude domain="sharedpref" path="meta.xml"/>
    </device-transfer>
</data-extraction-rules>